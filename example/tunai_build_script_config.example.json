{
  "upload": {
    "providers": {
      "ios": "apphost",
      "android": "telegram_apk"
    },
    "provider": "apphost",
    "changelog_path": null
  },
  "prepare_release": {
    "tag_prefix": "release"
  },
  "release_candidate": {
    "tag_prefix": "my-app-rc"
  },
  "channel": {
    "test": {
      "ios_bundle_id": "com.example.app.test"
    },
    "prod": {
      "ios_bundle_id": "com.example.app",
      "ios_export_options_plist": "ios/ExportOptions.prod-adhoc.plist",
      "env_overrides": {
        "TestVersion": "false"
      }
    }
  },
  "loadly": {
    "api_key": "your_loadly_api_key"
  },
  "buildport": {
    "api_token": "${BUILDPORT_API_TOKEN}",
    "app_group": "",
    "timeout_seconds": 600
  },
  "apphost": {
    "user_id": "your_user_id",
    "app_id": "your_app_id",
    "key": "your_key",
    "ios_bundle_identifier": "com.example.app",
    "android_package_name": "com.example.app"
  },
  "telegram": {
    "bot_token": "${TELEGRAM_BOT_TOKEN}",
    "chat_id": "${TELEGRAM_CHAT_ID}",
    "topic_id": ""
  },
  "ios": {
    "export_options_plist": "ios/ExportOptions.plist"
  },
  "macos_testflight": {
    "scheme": "Runner",
    "export_plist": "macos/ExportOptions.plist",
    "app_store_key_json_path": "path/to/app_store_connect_api_key.json"
  }
}
