{
  "upload": {
    "providers": {
      "ios": "buildport",
      "android": "telegram_apk"
    },
    "provider": "buildport",
    "changelog_path": null
  },
  "prepare_release": {
    "tag_prefix": "release"
  },
  "release_candidate": {
    "tag_prefix": "my-app-rc",
    "cumulative_changelog": {
      "from_tag_prefix": "my-app-prod",
      "path": "changelog_tester_since_prod.md",
      "telegram": {
        "chat_id": "${TELEGRAM_RELEASE_CHAT_ID}",
        "topic_id": "${TELEGRAM_RELEASE_TOPIC_ID}"
      }
    }
  },
  "channel": {
    "test": {
      "ios_bundle_id": "com.example.app.test",
      "ios_display_name": "Example Test",
      "env_overrides": {
        "TestVersion": "true"
      }
    },
    "prod": {
      "ios_bundle_id": "com.example.app",
      "ios_display_name": "Example",
      "ios_export_options_plist": "ios/ExportOptions.prod-adhoc.plist",
      "env_overrides": {
        "TestVersion": "false"
      }
    }
  },
  "loadly": {
    "api_key": "your_loadly_api_key"
  },
  "buildport": {
    "api_token": "${BUILDPORT_API_TOKEN}",
    "app_group": "",
    "timeout_seconds": 600
  },
  "telegram": {
    "bot_token": "${TELEGRAM_BOT_TOKEN}",
    "chat_id": "${TELEGRAM_CHAT_ID}",
    "topic_id": ""
  },
  "ios": {
    "export_options_plist": "ios/ExportOptions.plist"
  },
  "macos_testflight": {
    "scheme": "Runner",
    "export_plist": "macos/ExportOptions.plist",
    "app_store_key_json_path": "path/to/app_store_connect_api_key.json"
  }
}
